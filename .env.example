# ---------- Firebase (client) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in double quotes
FIREBASE_PRIVATE_KEY=

# Comma-separated emails allowed to become administrators on first sign-in.
# The first successful login sets the Firebase custom claim { admin: true }.
ADMIN_EMAILS=

# ---------- Cloudinary (server only, except cloud name) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------- Email notifications (optional) ----------
# Uses your own mailbox over SMTP. Zoho Mail: host smtp.zoho.com (EU: smtp.zoho.eu, India: smtp.zoho.in), port 465.
# If the mailbox has 2-step verification, create an "app password" in Zoho and use that as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where notifications are delivered (defaults to the contact email in Admin → Site content, then SMTP_USER)
NOTIFY_TO=

# --- AI Shoe & Foot Measurement platform ---
# Hours a measurement session (photos, results) is kept before automatic deletion. Default 72.
FOOT_RETENTION_HOURS=72

# CAD/BIM suite: hours before projects (files, models, issues) are deleted automatically
BIM_RETENTION_HOURS=72

# Vehicle detection demo: public URL of the FastAPI service (services/vehicle-tracker). Leave empty to offer only the in-browser engine.
VEHICLE_API_URL=

# Optional: base URL of the PPE monitoring service (services/ppe-monitor), e.g. https://ppe.example.com
# Without it, uploads are disabled and only the stored result of the bundled sample opens.
PPE_API_URL=

# Optional: base URL of the roof analysis service (services/roof-analyzer). Without it only stored sample results open.
ROOF_API_URL=

# Optional: base URL of the spatial reconstruction service (services/spatial-recon). Without it only the precomputed sample and local file viewing work.
SPATIAL_API_URL=

# Sports video intelligence service (services/sports-analyzer), e.g. http://localhost:8050
SPORTS_API_URL=

# Visual inspection service (services/defect-inspector), e.g. http://localhost:8060
DEFECT_API_URL=

# LiDAR point cloud service (services/lidar-wires), e.g. http://localhost:8070
LIDAR_API_URL=

# Human activity review service (services/activity-monitor), e.g. http://localhost:8090
ACTIVITY_API_URL=

# Document intelligence service (services/document-ocr), e.g. http://localhost:8100
DOCS_API_URL=

# ML lab service (services/ml-lab), e.g. http://localhost:8110 — classification, detection, segmentation, OCR, forecasting, sensors, pose, search, recommendation.
# The anomaly demo (no. 16) uses DEFECT_API_URL.
ML_API_URL=

# Business demo API (CRM/HRM/ERP persistence, workflows, BI import); empty = local-only browser storage
BIZ_API_URL=

# Video intelligence service (samples 22-24: restaurant area review, table tennis, basketball); empty = the demos show "service not connected"
VI_API_URL=
