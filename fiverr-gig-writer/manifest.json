{
  "manifest_version": 3,
  "name": "Fiverr Gig Helper",
  "version": "4.0.0",
  "description": "One paste box per Fiverr gig page, filled with one click. Optional Gemini AI writes the boxes from your notes and helps with category, metadata and pricing choices.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.fiverr.com/*"
  ],
  "action": {
    "default_title": "Fiverr Gig Helper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.fiverr.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}