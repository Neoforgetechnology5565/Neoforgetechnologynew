{
  "manifest_version": 3,
  "name": "Fiverr Gig Helper",
  "version": "3.0.0",
  "description": "Paste your gig text once, then fill each Fiverr gig page (Overview, Scope & Pricing, Description & FAQ, Requirements, Gallery) with one click. No AI, nothing is rewritten.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.fiverr.com/*"
  ],
  "action": {
    "default_title": "Fiverr Gig Helper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.fiverr.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}